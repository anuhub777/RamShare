# RAMShare Environment Configuration
# Copy this file to .env and fill in values

# Mode: "local" or "aws"
RAMSHARE_MODE=local

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-random-secret-key-in-production
DEBUG=true

# Local development database
DATABASE_URL=sqlite:///./ramshare.db

# AWS Configuration (only needed when RAMSHARE_MODE=aws)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Cognito (only needed when RAMSHARE_MODE=aws)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# DynamoDB (only needed when RAMSHARE_MODE=aws)
DYNAMODB_USERS_TABLE=ramshare-users
DYNAMODB_PROVIDERS_TABLE=ramshare-providers
DYNAMODB_JOBS_TABLE=ramshare-jobs
DYNAMODB_CREDITS_TABLE=ramshare-credits

# SQS (only needed when RAMSHARE_MODE=aws)
SQS_JOB_QUEUE_URL=
SQS_DLQ_URL=

# S3 (only needed when RAMSHARE_MODE=aws)
S3_BUCKET=ramshare-storage

# Provider Agent
PROVIDER_API_URL=http://localhost:8000
PROVIDER_HEARTBEAT_INTERVAL=30
PROVIDER_MAX_CPU_PERCENT=50
PROVIDER_MAX_RAM_MB=2048
PROVIDER_MAX_CONCURRENT_JOBS=2

# Frontend
VITE_API_URL=http://localhost:8000
